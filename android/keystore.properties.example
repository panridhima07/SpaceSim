# Copy to keystore.properties (same folder) and fill in. keystore.properties and the .jks file
# are ignored by git: keep a backup somewhere safe. If the key is lost, the app can never be
# updated under the same package name.
storeFile=astra-release.jks
storePassword=YOUR-KEYSTORE-PASSWORD
keyAlias=astra
keyPassword=YOUR-KEYSTORE-PASSWORD
